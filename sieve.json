{
  "targets": [
    {
      "name": "aegis-ledger",
      "image": "ghcr.io/ahmedelgmal310/aegis-ledger:main",
      "owner": "payments",
      "exposure": "internet",
      "gate": true
    },
    {
      "name": "aegis-responder",
      "image": "ghcr.io/ahmedelgmal310/aegis-responder:main",
      "owner": "security",
      "exposure": "internal",
      "gate": true
    },
    {
      "name": "nginx",
      "image": "nginx:1.25.3",
      "owner": "platform",
      "exposure": "internet",
      "gate": false
    },
    {
      "name": "python",
      "image": "python:3.10.12-slim",
      "owner": "data",
      "exposure": "internal",
      "gate": false
    },
    {
      "name": "node",
      "image": "node:18.19.0-slim",
      "owner": "web",
      "exposure": "internet",
      "gate": false
    },
    {
      "name": "postgres",
      "image": "postgres:14.10",
      "owner": "platform",
      "exposure": "internal",
      "gate": false
    },
    {
      "name": "redis",
      "image": "redis:7.2.3",
      "owner": "platform",
      "exposure": "internal",
      "gate": false
    }
  ],
  "policy": {
    "epssUrgent": 0.5,
    "epssHigh": 0.1,
    "slaDays": { "P0": 2, "P1": 7, "P2": 30, "P3": 90 },
    "notAffected": [
      {
        "purlPrefix": "pkg:deb/debian/linux-libc-dev@",
        "justification": "vulnerable_code_not_in_execute_path",
        "impact": "linux-libc-dev only ships kernel headers for compiling; a container runs the host's kernel, never this one"
      }
    ]
  }
}
